  "license": "MIT",
  "upstream_inspiration": "qiaomu-meta-skill; K-Dense-AI/scientific-agent-skills scientific-visualization; local easyplot; local nature-figure; local journal-ggplot-stylebook; local sci-color-palettes",
  "intent": {
    "job_to_be_done": "为科研图表选择、映射和审查适合期刊传播的艺术化配色，并输出可复用代码。",
    "target_users": ["GWAS/omics researchers", "R and Python figure authors", "journal figure reviewers"],
    "inputs": ["figure type", "semantic groups", "category order", "background", "final size", "target journal or medium", "optional card-draw description or selected image", "card manifest plus figure-specific SCI candidate request"],
    "outputs": ["compact primary and alternatives route", "theme-aware palette brief from title/fragment/figure meaning", "topic-anchored image search plan", "directional A/B/C candidate plan", "style family and rationale", "semantic HEX mapping", "layer mapping contract", "preference constraints and rejected candidates", "candidate diversity audit with family and CIE76 distance", "bounded human review questions", "author decision log", "visual palette preview", "normal/CVD/grayscale/target-size preview card", "R/ggplot2 code", "Python code", "accessibility and print audit", "optional SCI application profile and gate", "provenance", "assumptions", "optional draw cards and extracted candidate palette", "joint visual-card/SCI semantic candidate preview"],
    "exclusions": ["brand identity", "web UI themes", "photo correction", "statistical analysis", "journal acceptance guarantee"]
  },
  "qiaomu_defaults": {
    "language": "zh-CN",
    "primary_style": "ink-mineral-a-sunlit",
    "max_alternatives": 2,
    "default_background": "#FFFFFF",
    "preserve_category_order": true
  },
  "release_gates": {
    "secret_scan": true,
    "trigger_eval": true,
    "install_check": true,
    "human_figure_review": true,
    "publication": false
  }
}
